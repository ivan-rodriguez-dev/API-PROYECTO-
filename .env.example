# Copie este archivo como .env solo para documentar las variables requeridas.
# No use estos valores ficticios en produccion.
JWT_SECRET=ejemplo_cambie_esta_clave_por_una_larga_y_aleatoria_de_32_caracteres
APP_CORS_ORIGENES=http://localhost:8081
APP_ADMIN_USUARIO=administrador.tienda
APP_ADMIN_NOMBRE=Administrador de la tienda
APP_ADMIN_PASSWORD=ejemplo_cambie_esta_clave
# Opcional: carga datos de ejemplo ficticios en el primer arranque del perfil prod
APP_DATOS_INICIALES=classpath:datos-ejemplo.sql
# Opcional: Railway define PORT; si no existe, la API usa 8080
PORT=8080
